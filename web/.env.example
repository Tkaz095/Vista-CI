# Server-only settings. Copy to .env.local (ignored by Git).
# Never prefix these names with VITE_. Never commit actual secrets.
VISTA_APP_ORIGIN=http://localhost:5173
FIREBASE_PROJECT_ID=vista-ci
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate privately: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64'))"
GITHUB_TOKEN_ENCRYPTION_KEY=

# Local option: Application Default Credentials from a file OUTSIDE the repo.
GOOGLE_APPLICATION_CREDENTIALS=

# Vercel / alternative local option: set BOTH below in server environment.
# PRIVATE_KEY uses the full PEM, with literal backslash-n between lines if needed.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin monitoring: server only. No new key is required; reuse Admin credentials.
MONITORING_FIREBASE_APP_ID=1:1087429884658:android:cdfbf3a5d8a08c0d1a6e6b
# Set these AFTER enabling Crashlytics / Firebase Sessions BigQuery export.
# Copy exact project.dataset.table names from BigQuery; choose batch OR realtime.
CRASHLYTICS_BIGQUERY_TABLE=
SESSIONS_BIGQUERY_TABLE=
# Dataset location, e.g. US, EU or asia-southeast1. Both tables must match.
BIGQUERY_LOCATION=
