<?xml version="1.0" encoding="utf-8"?>
<!-- Keystore keys cannot follow ciphertext onto another device. Exclude app
     preferences (including encrypted credentials) from backup and transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
