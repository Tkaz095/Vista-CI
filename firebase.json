{
  "functions": [
    {
      "source": "functions",
      "codebase": "vista",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "test", "*.log", ".secret.local", ".env.local", ".env.example", ".secret.local.example"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "hosting": {
    "public": "web/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "predeploy": ["npm --prefix web run build"],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {"functionId": "vistaApi", "region": "asia-southeast1"}
      },
      {"source": "**", "destination": "/index.html"}
    ]
  },
  "firestore": {"rules": "firebase/firestore.rules"},
  "emulators": {
    "functions": {"host": "127.0.0.1", "port": 5001},
    "hosting": {"host": "127.0.0.1", "port": 5000},
    "ui": {"enabled": false},
    "singleProjectMode": true
  }
}
